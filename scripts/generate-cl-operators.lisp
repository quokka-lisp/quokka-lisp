;;;; Generate tests/ansi/cl-operators.lisp: the names of the COMMON-LISP
;;;; symbols that SBCL defines as a function, a macro or a special operator.
;;;;
;;;;   sbcl --script scripts/generate-cl-operators.lisp > tests/ansi/cl-operators.lisp
;;;;
;;;; The ansi-test runner (#60) uses it to tell an operator Quokka lacks
;;;; (LOOP, TYPEP …) from a symbol that is only data or a type name, so that
;;;; a test using one is reported as "needs X" instead of failing. DECLARE is
;;;; added by hand: it is not an operator in SBCL either, but a form that
;;;; uses it cannot work in a Lisp that does not accept declarations.

(let ((names '("DECLARE")))
  (do-external-symbols (s :common-lisp)
    (when (or (fboundp s) (special-operator-p s))
      (push (symbol-name s) names)))
  (setf names (sort (remove-duplicates names :test #'string=) #'string<))
  (format t ";;;; Generated by scripts/generate-cl-operators.lisp from SBCL ~A. Do not edit.~%"
          (lisp-implementation-version))
  (format t ";;;; The COMMON-LISP operators, for the ansi-test runner (#60).~%~%")
  (format t "(setq rt::*cl-operator-names* '(~%")
  (dolist (n names) (format t "  ~S~%" n))
  (format t "))~%"))
