(let ((names '()))
  (do-external-symbols (s :common-lisp) (push (symbol-name s) names))
  (setf names (sort names #'string<))
  (format t ";;;; The ~D external symbols of COMMON-LISP, by name.~%" (length names))
  (format t ";;;;~%;;;; Data, not code: the names the standard puts in the COMMON-LISP package,~%")
  (format t ";;;; generated once from SBCL — the oracle Quokka is already measured against —~%")
  (format t ";;;; with scripts/generate-cl-symbols.lisp. A name is a fact, so this is not~%")
  (format t ";;;; copied code. Packages (#41, #43) adopt each one into COMMON-LISP, creating the~%")
  (format t ";;;; symbols Quokka has not needed yet, so that every standard name is there.~%~%")
  (format t "(defparameter %common-lisp-symbol-names~%  '(")
  (let ((column 4) (first t))
    (dolist (n names)
      (let ((text (prin1-to-string n)))
        (cond (first (setf first nil))
              ((> (+ column 1 (length text)) 78) (format t "~%    ") (setf column 4))
              (t (format t " ") (incf column)))
        (format t "~A" text)
        (incf column (length text)))))
  (format t "))~%"))
