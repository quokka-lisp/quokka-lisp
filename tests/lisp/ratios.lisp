;;; Ratios (step AI, #59): exact quotients of integers, always in lowest
;;; terms. Tier 1: compiled and SBCL only. Floats are read as doubles, as in
;;; every float file.
(setq *read-default-float-format* 'double-float)

;; Division of integers is exact.
(/ 1 3)
(/ 6 4)
(/ 4 2)
(/ -6 4)
(/ 6 -4)
(/ 3)
(/ 1 3 4)
(/ (expt 10 30) (expt 10 28))
(/ 1 (expt 2 70))

;; Arithmetic between ratios and integers.
(+ 1/3 2/3)
(+ 1/2 1/3 1/6)
(- 1/2 1/3)
(- 1/2)
(* 2/3 3/4)
(* 2/3 3)
(/ 1/2 1/4)
(+ (/ 1 (expt 2 70)) 1)

;; Comparison, exact even against floats.
(< 1/3 1/2)
(> 1/3 1/2)
(= 1/2 2/4)
(= 1/2 0.5)
(< 1/3 0.3333333333333333)
(> 1/3 0.3333333333333333)
(max 1/2 1/3 0.25)
(min 1/2 1/3)
(zerop 0/5)
(plusp -1/2)

;; Contagion: a ratio meeting a float becomes a float.
(+ 1/2 0.25)
(* 1/3 3.0)

;; Parts and conversions.
(numerator 6/4)
(denominator 6/4)
(numerator -3/6)
(denominator -3/6)
(numerator 5)
(denominator 5)
(float 1/3 1.0)
(float -2/3 1.0)
(float 1/10 1.0)
(float (/ 1 (expt 3 40)) 1.0)
(float (/ (expt 10 40) 3) 1.0)
(rational 0.5)
(rational 0.1)
(rational -2.5)
(rational 3)
(rationalize 0.1)
(rationalize 0.5)
(rationalize -0.75)
(rationalize 3.14159)
(rationalize 1.0e-10)

;; Division and rounding.
(multiple-value-list (floor 7/2))
(multiple-value-list (ceiling 7/2))
(multiple-value-list (truncate -7/2))
(multiple-value-list (round 5/2))
(multiple-value-list (round 7/2))
(multiple-value-list (floor 7 2/3))
(multiple-value-list (truncate 1/2 1/3))
(mod 7/2 1)
(rem -7/2 1)
(mod -1/3 1/2)

;; expt and friends. (sqrt of a ratio is a single-float in SBCL, a double here.)
(expt 2 -3)
(expt 2/3 3)
(expt 1/2 -2)
(expt -2/3 2)
(abs -2/3)
(signum -2/3)
(1+ 1/2)

;; eql, equal, equalp and hash tables.
(eql 1/2 (/ 2 4))
(eql 1/2 1/3)
(equal 1/2 (/ 3 6))
(equalp 1/2 0.5)
(let ((h (make-hash-table))) (setf (gethash 1/2 h) :half) (gethash (/ 3 6) h))
(let ((h (make-hash-table :test 'equalp))) (setf (gethash 1/2 h) :half) (gethash 0.5 h))
(let ((h (make-hash-table :test 'equal))) (setf (gethash (/ 1 (expt 2 70)) h) :tiny)
  (gethash (expt 2 -70) h))

;; Predicates.
(rationalp 1/2)
(rationalp 0.5)
(realp 1/2)
(numberp 1/2)
(integerp 1/2)
(floatp 1/2)

;; Reading and printing.
(read-from-string "2/4")
(read-from-string "-10/15")
(read-from-string "+3/9")
(let ((*read-base* 16)) (read-from-string "a/f"))
(let ((*read-base* 2)) (read-from-string "1/11"))
(prin1-to-string 2/3)
(princ-to-string -1/3)
(let ((*print-base* 16)) (prin1-to-string 10/3))
(let ((*print-base* 16) (*print-radix* t)) (prin1-to-string 10/3))
(let ((*print-radix* t)) (prin1-to-string 1/3))
(let ((*print-base* 2) (*print-radix* t)) (prin1-to-string -5/3))
(format nil "~A ~S ~D" 1/2 -3/4 5/6)
(list 1/2 (list 2/3))
(handler-case (/ 1 0) (division-by-zero () :division-by-zero))
(handler-case (/ 1/2 0) (division-by-zero () :division-by-zero))
