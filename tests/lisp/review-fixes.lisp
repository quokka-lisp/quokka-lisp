;;; One lexical environment in the compiler (#111): which of a local macro
;;; and a local function is nearer, what an expander may see, what a macro
;;; is told, and a `go` past each kind of thing that can be open.
(macrolet ((f (x) (list 'quote (list :macro x))))
  (labels ((f (x) (list :function x)) (g (x) (f x)))
    (list (f 1) (g 2))))
(macrolet ((f (x) (list 'quote (list :macro x))))
  (flet ((f (x) (list :function x)))
    (macrolet ((g (x) (list 'f x)))
      (list (f 1) (g 2) (macrolet ((f (x) (list 'quote (list :inner x)))) (f 3))))))
(symbol-macrolet ((s 10)) (macrolet ((m () (+ s 1))) (m)))
(macrolet ((outer () 5)) (macrolet ((m () (+ (outer) 1))) (m)))
(defmacro env-probe (name &environment e)
  (list 'quote (list (if (macro-function name e) t nil) (nth-value 1 (macroexpand-1 name e)))))
(macrolet ((local () 1))
  (symbol-macrolet ((local 2))
    (flet ((other () 3))
      (list (env-probe local) (env-probe other) (env-probe car)))))
(macrolet ((local () 1)) (flet ((local () 3)) (env-probe local)))
(symbol-macrolet ((local 2)) (let ((local 3)) (list local (env-probe local))))
(let ((n 0) (cleanups nil))
  (tagbody
   again
     (setq n (+ n 1))
     (let ((m n)) (if (< m 2) (go again)))
     (block b (if (< n 3) (go again)))
     (catch 'c (if (< n 4) (go again)))
     (unwind-protect (if (< n 5) (go again)) (setq cleanups (cons n cleanups)))
     (funcall (lambda () (if (< n 6) (go again))))
     (tagbody (if (< n 7) (go again)))
     (tagbody inner (setq n (+ n 1)) (if (< n 10) (go inner))))
  (list n cleanups))
