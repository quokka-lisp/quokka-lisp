;; Wide and deep specifiers stay cheap.
(defparameter *symbols* (let ((symbols nil)) (dotimes (i 1000) (push (gensym) symbols)) symbols))
(multiple-value-list (subtypep (cons 'member *symbols*) 'symbol))
(multiple-value-list (subtypep 'symbol (cons 'member *symbols*)))
(multiple-value-list (subtypep (cons 'member *symbols*) (cons 'member (cdr *symbols*))))
(let ((deep 'null)) (dotimes (i 20) (setq deep (list 'cons 'integer deep))) (multiple-value-list (subtypep deep 'list)))
(let ((deep 'null)) (dotimes (i 20) (setq deep (list 'cons 'integer deep))) (multiple-value-list (subtypep 'list deep)))
;; -0.0 is in a range that holds 0.0, but is not eql to 0.0.
(multiple-value-list (subtypep '(double-float 0.0 1.0) '(or (double-float (0.0) 1.0) (member 0.0))))
(multiple-value-list (subtypep '(double-float 0.0 1.0) '(or (double-float (0.0) 1.0) (member 0.0 -0.0))))
(multiple-value-list (subtypep '(member -0.0) '(double-float 0.0 *)))
(multiple-value-list (subtypep '(member -0.0) '(double-float (0.0) *)))
;; Two strings that are equal are still two objects.
(let ((a (copy-seq "abc")) (b (copy-seq "abc"))) (multiple-value-list (subtypep `(member ,a) `(member ,b))))
(let ((a (copy-seq "abc"))) (multiple-value-list (subtypep `(eql ,a) 'string)))
(let ((a (copy-seq "abc"))) (multiple-value-list (subtypep `(member ,a) `(or (member ,a) integer))))
;; Two lists that are equal are still two objects.
(let ((a (copy-list '(a b c))) (b (copy-list '(a b c)))) (multiple-value-list (subtypep `(member ,a) `(member ,b))))
(let ((a (copy-list '(a b c))) (b (copy-list '(a b c)))) (multiple-value-list (subtypep `(eql ,a) `(eql ,b))))
;; or and not together.
(multiple-value-list (subtypep t '(or (not (member a b c d)) t)))
(multiple-value-list (subtypep t '(or (not (member a b c d e)) symbol)))
(multiple-value-list (subtypep t '(or (not (real 0 10)) (not (real -100 -50)))))
(multiple-value-list (subtypep t '(or (not spoint3) (not spoint))))
(multiple-value-list (subtypep t '(or (not (eql a)) (not (or (member b c d) (eql e))))))
