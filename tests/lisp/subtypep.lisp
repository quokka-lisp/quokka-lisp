;;; subtypep (phase 3, step A1, #124): the type algebra, against SBCL.
;;; Tier 1: compiled and SBCL only. Quokka has one float format, so
;;; pairs that tell short, single, double and long floats apart are
;;; left out: SBCL has two formats and answers them differently, as
;;; CLHS 12.1.4.1.1 allows both to. Also left out, because the answer
;;; depends on what else an implementation has: `string` against `(vector
;;; character)` (SBCL has base strings, Quokka has none, so to Quokka they
;;; are the same type); `sequence` against `(or list vector)` (SBCL lets a
;;; program define more sequences); and `(eql a)` against `keyword`, which
;;; SBCL answers "don't know", as `subtypep` may.
(setq *read-default-float-format* 'double-float)
(defstruct spoint x)
(defstruct (spoint3 (:include spoint)) z)
(deftype small () '(integer 0 9))

